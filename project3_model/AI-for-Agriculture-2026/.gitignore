# Data & Datasets (NEVER push raw data)
Data/
data/
dataset/
data_split/

# Model Checkpoints (NEVER push heavy weights, except lightweight hybrid_ensemble_v6.joblib for web deployment)
checkpoints/*
*.pt
*.pth
*.pt1
*.ckpt
*.joblib
!checkpoints/hybrid_ensemble_v6.joblib

# WandB & Logs
wandb/
**/wandb/
*.log

# Jupyter & Python cache
.ipynb_checkpoints/
*__pycache__*
*.pyc

# Misc & Office lock files
misc/
eda/
tools/
~$*.docx
~$*.xlsx

# Raw image/spectral & temporary CSV artifacts
*.png
*.tif
*.tiff
*.csv

# Explicitly keep key v6 research summary CSVs & publication charts
!TONG_HOP_THUC_NGHIEM.csv
!TONG_HOP_CHECKPOINT.csv
!submission_hybrid_v6.csv
!outputs/hybrid_v6_val_confusion_matrix.png
!outputs/research_benchmark_v6.png
!outputs/overfit_analysis_v5_vs_v6.png
